<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingEnd="12dp">

    <!-- Outer focus ring wrapper -->
    <FrameLayout
        android:id="@+id/card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:foreground="@drawable/apple_focus_ring"
        android:focusable="true"
        android:clickable="true">

        <!-- Cinematic 16:9 Artwork Card (160x90dp) -->
        <FrameLayout
            android:id="@+id/surface"
            android:layout_width="160dp"
            android:layout_height="90dp"
            android:clipToOutline="true"
            android:background="@drawable/apple_card_surface">

            <ImageView
                android:id="@+id/backdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:contentDescription="@null" />
        </FrameLayout>
    </FrameLayout>

    <!-- Title & Metadata cleanly BELOW the card -->
    <TextView
        android:id="@+id/mediaTitle"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginStart="2dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="#F1F5F9"
        android:textSize="12sp"
        android:fontFamily="@font/outfit" />

    <TextView
        android:id="@+id/mediaSub"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="#94A3B8"
        android:textSize="10sp"
        android:fontFamily="@font/outfit" />
</LinearLayout>
