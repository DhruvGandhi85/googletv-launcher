<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingEnd="10dp">

    <FrameLayout
        android:id="@+id/card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:foreground="@drawable/apple_focus_ring"
        android:focusable="true"
        android:clickable="true">

        <!-- Clean 220x92dp Modern Sports Scoreboard Card -->
        <LinearLayout
            android:id="@+id/surface"
            android:layout_width="220dp"
            android:layout_height="92dp"
            android:clipToOutline="true"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/apple_card_surface">

            <!-- Top Row: Live Clock / Status & Broadcast Channel & Odds -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/statusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="7dp"
                    android:paddingEnd="7dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:layout_marginEnd="6dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="9.5sp"
                    android:fontFamily="@font/outfit"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/channelBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:textColor="#38BDF8"
                    android:textSize="9.5sp"
                    android:fontFamily="@font/outfit"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/networkBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="#CBD5E1"
                    android:textSize="9.5sp"
                    android:fontFamily="@font/outfit"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Away Team Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/awayBar"
                    android:layout_width="3.5dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="7dp" />

                <ImageView
                    android:id="@+id/awayLogo"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/awayTeam"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#F8FAFC"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/awayScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#F8FAFC"
                    android:textSize="13.5sp"
                    android:fontFamily="@font/outfit"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- Home Team Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3.5dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/homeBar"
                    android:layout_width="3.5dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="7dp" />

                <ImageView
                    android:id="@+id/homeLogo"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/homeTeam"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#F8FAFC"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/homeScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#F8FAFC"
                    android:textSize="13.5sp"
                    android:fontFamily="@font/outfit"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
