<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0A0C10">

    <!-- CINEMATIC DYNAMIC HERO BACKDROPS (GPU HARDWARE ACCELERATED) -->
    <ImageView
        android:id="@+id/heroBackdropA"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/heroBackdropB"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:contentDescription="@null" />

    <!-- MULTI-STOP VIGNETTE AND CONTRAST SCRIMS -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/hero_scrim_vertical" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/hero_scrim_horizontal" />

    <LinearLayout
        android:id="@+id/mainContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingLeft="58dp"
        android:paddingRight="58dp"
        android:paddingTop="28dp"
        android:paddingBottom="18dp">

        <!-- COMPACT APPLE TV TOP BAR -->
        <!-- CLEAN GOOGLE TV / APPLE TV STYLE TOP BAR -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <!-- Personalized Greeting & Time (CleanYourTV style) -->
            <TextView
                android:id="@+id/greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFF4F6FA"
                android:textSize="17sp"
                android:text="Good morning" />

            <View
                android:layout_width="1dp"
                android:layout_height="14dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:background="#33FFFFFF" />

            <TextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:textColor="#B3EBF5FF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:fontFamily="sans-serif"
                android:textColor="#77EBF5FF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/weatherPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#CCEBF5FF"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Spacer pushes buttons cleanly to the right -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Hidden placeholders so old references compile safely -->
            <TextView
                android:id="@+id/heroName"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/heroSub"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnTrakt"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnStremio"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnRemap"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnWifi"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <!-- GOOGLE TV STYLE TOP NAVIGATION TABS -->
            <TextView
                android:id="@+id/btnTabHome"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginRight="7dp"
                android:background="@drawable/pill_active_bg"
                android:focusable="true"
                android:gravity="center"
                android:paddingLeft="13dp"
                android:paddingRight="13dp"
                android:fontFamily="sans-serif-medium"
                android:text="Home"
                android:textColor="@drawable/pill_active_text"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/btnTabSports"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginRight="7dp"
                android:background="@drawable/pill_bg"
                android:focusable="true"
                android:gravity="center"
                android:paddingLeft="13dp"
                android:paddingRight="13dp"
                android:fontFamily="sans-serif-medium"
                android:text="Sports"
                android:textColor="@drawable/pill_text"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/btnTabMedia"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginRight="7dp"
                android:background="@drawable/pill_bg"
                android:focusable="true"
                android:gravity="center"
                android:paddingLeft="13dp"
                android:paddingRight="13dp"
                android:fontFamily="sans-serif-medium"
                android:text="Trakt"
                android:textColor="@drawable/pill_text"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/btnTabApps"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginRight="12dp"
                android:background="@drawable/pill_bg"
                android:focusable="true"
                android:gravity="center"
                android:paddingLeft="13dp"
                android:paddingRight="13dp"
                android:fontFamily="sans-serif-medium"
                android:text="Apps"
                android:textColor="@drawable/pill_text"
                android:textSize="11.5sp" />

            <!-- Spacer divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="14dp"
                android:layout_marginRight="10dp"
                android:background="#33FFFFFF" />

            <!-- TOOLS (Inputs, Google TV, Settings) -->
            <TextView
                android:id="@+id/btnInputs"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginRight="7dp"
                android:background="@drawable/pill_bg"
                android:focusable="true"
                android:gravity="center"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="Inputs"
                android:textColor="@drawable/pill_text"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/btnGoogleTv"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginRight="7dp"
                android:background="@drawable/pill_bg"
                android:focusable="true"
                android:gravity="center"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="Google TV"
                android:textColor="@drawable/pill_text"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/btnSettings"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/pill_bg"
                android:focusable="true"
                android:gravity="center"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="Settings"
                android:textColor="@drawable/pill_text"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/btnAssistant"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- CINEMATIC APPLE TV / GOOGLE TV HERO SPOTLIGHT STAGE -->
        <LinearLayout
            android:id="@+id/heroStage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="84dp"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="6dp"
            android:paddingLeft="4dp"
            android:paddingRight="4dp">

            <!-- HERO BADGES ROW (Clean, radical simplicity: hidden to eliminate eyebrow clutter) -->
            <LinearLayout
                android:id="@+id/heroBadges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/heroTag"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:background="@drawable/hero_badge_bg"
                    android:gravity="center"
                    android:paddingLeft="9dp"
                    android:paddingRight="9dp"
                    android:textColor="#FF4DD0E1"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-bold"
                    android:text="UP NEXT" />

                <TextView
                    android:id="@+id/heroRating"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/hero_badge_bg"
                    android:gravity="center"
                    android:paddingLeft="9dp"
                    android:paddingRight="9dp"
                    android:textColor="#FFFFD700"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-bold"
                    android:text="★ 8.8" />

                <TextView
                    android:id="@+id/heroExtraBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:layout_marginLeft="8dp"
                    android:background="@drawable/hero_badge_bg"
                    android:gravity="center"
                    android:paddingLeft="9dp"
                    android:paddingRight="9dp"
                    android:textColor="#FFF4F6FA"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:text="2024" />

                <TextView
                    android:id="@+id/heroActionPrompt"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/heroTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-bold"
                android:textColor="#FFFFFFFF"
                android:textSize="26sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="" />

            <TextView
                android:id="@+id/heroDesc"
                android:layout_width="760dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:textColor="#B8EBF5FF"
                android:textSize="12sp"
                android:maxLines="2"
                android:lineSpacingExtra="2dp"
                android:ellipsize="end"
                android:text="" />
        </LinearLayout>

        <!-- HARDWARE-CULLED VERTICAL SCROLLING APPLE TV SHELVES -->
        <ScrollView
            android:id="@+id/hubScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="true"
            android:clipToPadding="false"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/hubContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingTop="6dp"
                android:paddingBottom="64dp">

                <!-- SHELF 1: APPS & FOLDERS -->
                <LinearLayout
                    android:id="@+id/shelfAppsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/shelfAppsTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:layout_marginBottom="3dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Apps"
                        android:textColor="#D9FFFFFF"
                        android:textSize="14sp" />

                    <HorizontalScrollView
                        android:id="@+id/dockScroll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:scrollbars="none"
                        android:overScrollMode="never">

                        <LinearLayout
                            android:id="@+id/dockRow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:gravity="center_vertical" />
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- ROKU-STYLE APPS GRID SECTION (Dedicated for Apps Tab) -->
                <LinearLayout
                    android:id="@+id/appsGridSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginLeft="4dp"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:id="@+id/appsGridTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Installed Channels &amp; Apps"
                            android:textColor="#D9FFFFFF"
                            android:textSize="15sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/btnNewFolder"
                            android:layout_width="wrap_content"
                            android:layout_height="24dp"
                            android:background="@drawable/pill_bg"
                            android:foreground="@drawable/apple_focus_ring"
                            android:gravity="center"
                            android:paddingLeft="10dp"
                            android:paddingRight="10dp"
                            android:focusable="true"
                            android:clickable="true"
                            android:textColor="@drawable/pill_text"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-medium"
                            android:text="+ New Folder" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/appsGridRows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- SHELF 2: LIVE & UPCOMING SPORTS -->
                <LinearLayout
                    android:id="@+id/shelfSportsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginLeft="4dp"
                        android:layout_marginBottom="3dp">

                        <TextView
                            android:id="@+id/shelfSportsTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Live &amp; Upcoming Sports"
                            android:textColor="#D9FFFFFF"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/sportsStatus"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/btnSportsSettings"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone"
                            android:focusable="false"
                            android:clickable="false" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:id="@+id/sportsScroll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:scrollbars="none"
                        android:overScrollMode="never">

                        <LinearLayout
                            android:id="@+id/sportsRow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- DEDICATED SPORTS LAUNCHER EXTRA SHELVES (NBA, NFL, CFB, NHL) -->
                <LinearLayout
                    android:id="@+id/sportsExtraShelvesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <!-- DYNAMIC TRAKT SHELVES CONTAINER -->
                <LinearLayout
                    android:id="@+id/traktShelvesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- OVERLAY PANEL (Folders, Inputs, Sports Stream Chooser, Trakt Setup) -->
    <FrameLayout
        android:id="@+id/inputsScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B8000000"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone">

        <ScrollView
            android:id="@+id/inputsScroll"
            android:layout_width="740dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:background="@drawable/dropdown_bg"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/inputsPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:orientation="vertical"
                android:padding="26dp" />
        </ScrollView>
    </FrameLayout>

</FrameLayout>
